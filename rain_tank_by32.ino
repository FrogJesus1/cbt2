// ── Ping handler (WiFi WebServer) ────────────────────────
// Farm OS calls this to check if the node is alive.
// Returns per-channel status so the dashboard shows what's up/down.
void handlePing() {
  char response[512];
  int wifi_up = (WiFi.status() == WL_CONNECTED) ? 1 : 0;
  snprintf(response, sizeof(response),
    "{\"type\":\"pong\",\"node_id\":\"%s\",\"uptime_seconds\":%u,\"wifi_rssi\":%d,\"free_heap_bytes\":%u,\"ch_wifi\":%d,\"ch_serial\":1}",
    NODE_ID, (unsigned int)(millis() / 1000), WiFi.RSSI(), ESP.getFreeHeap(), wifi_up);
  server.send(200, "application/json", response);
}
// ═══════════════════════════════════════════════════════════════
//  RUNTIME POWER MODE — stored in NVS, changeable via serial
//  Send POWER:low_power / POWER:solar / POWER:powered
// ═══════════════════════════════════════════════════════════════
Preferences nvsPrefs;
// Power mode constants — match power_packages.json keys
#define PM_LOW_POWER  0  // low_power_remote — deep sleep
#define PM_SOLAR      1  // solar_node — light sleep
#define PM_POWERED    2  // powered_node — always on
// Compiled default (from power_packages.json): powered_node
uint8_t powerMode = PM_POWERED;
// Timing — set by applyPowerMode(), used in loop()
const unsigned long defaultSensorIntervalMs = 5000UL;  // restore to this when test mode is off
unsigned long sensorIntervalMs  = 5000UL;
unsigned long transmitIntervalMs = 5000UL;
void applyPowerMode(uint8_t mode) {
  powerMode = mode;
  switch (mode) {
    case PM_LOW_POWER:
      sensorIntervalMs  = 900000UL;   // 15 min
      transmitIntervalMs = 900000UL;
      Serial.println("  POWER MODE: low_power (deep sleep / duty cycle)");
      break;
    case PM_SOLAR:
      sensorIntervalMs  = 120000UL;   // 2 min
      transmitIntervalMs = 120000UL;
      Serial.println("  POWER MODE: solar (light sleep / duty cycle)");
      break;
    case PM_POWERED:
    default:
      sensorIntervalMs  = 5000UL;     // 5s
      transmitIntervalMs = 5000UL;
      Serial.println("  POWER MODE: powered (always on)");
      break;
  }
}
void loadPowerModeFromNVS() {
  nvsPrefs.begin("farmos", true);  // read-only
  uint8_t stored = nvsPrefs.getUChar("pwr_mode", 255);
  nvsPrefs.end();
  if (stored <= 2) {
    Serial.print("  NVS power mode override: ");
    Serial.println(stored);
    applyPowerMode(stored);
  } else {
    applyPowerMode(PM_POWERED);  // compiled default
  }
}
void savePowerModeToNVS(uint8_t mode) {
  nvsPrefs.begin("farmos", false);  // read-write
  nvsPrefs.putUChar("pwr_mode", mode);
  nvsPrefs.end();
  Serial.println("  Power mode saved to NVS — persists across reboots.");
}
// Parse serial commands: POWER:low_power, POWER:solar, POWER:powered, POWER:reset
bool handlePowerCommand(const String& cmd) {
  if (!cmd.startsWith("POWER:")) return false;
  String mode = cmd.substring(6);
  mode.trim();
  if (mode == "low_power" || mode == "low") {
    applyPowerMode(PM_LOW_POWER);
    savePowerModeToNVS(PM_LOW_POWER);
  } else if (mode == "solar" || mode == "medium") {
    applyPowerMode(PM_SOLAR);
    savePowerModeToNVS(PM_SOLAR);
  } else if (mode == "powered" || mode == "high") {
    applyPowerMode(PM_POWERED);
    savePowerModeToNVS(PM_POWERED);
  } else if (mode == "reset") {
    // Clear NVS override — revert to compiled default on next boot
    nvsPrefs.begin("farmos", false);
    nvsPrefs.remove("pwr_mode");
    nvsPrefs.end();
    applyPowerMode(PM_POWERED);
    Serial.println("  Power mode reset to compiled default.");
  } else {
    Serial.println("  Unknown power mode. Use: low_power, solar, powered, reset");
    return false;
  }
  return true;
}
// ── Config Query — ask Farm OS Server where to send data ────
// Queries GET /api/v1/node-config/{node} on the production server.
// Response: {"server_ip":"x.x.x.x","server_port":5050,"mode":"production"}
void fetchServerConfig() {
  if (WiFi.status() != WL_CONNECTED) return;
  HTTPClient http;
  http.begin("http://" + String(PROD_SERVER_IP) + ":" + String(PROD_SERVER_PORT) + "/api/v1/node-config/rain_tank_by32");
  http.setTimeout(3000);
  int httpCode = http.GET();
  if (httpCode == 200) {
    String body = http.getString();
    // Simple JSON parsing — find "server_ip":"..." and "server_port":...
    int ipStart = body.indexOf("\"server_ip\":\"");
    if (ipStart >= 0) {
      ipStart += 13;
      int ipEnd = body.indexOf("\"", ipStart);
      if (ipEnd > ipStart && (ipEnd - ipStart) < 16) {
        String newIP = body.substring(ipStart, ipEnd);
        newIP.toCharArray(targetServerIP, 16);
      }
    }
    int portStart = body.indexOf("\"server_port\":");
    if (portStart >= 0) {
      portStart += 14;
      int portEnd = body.indexOf(",", portStart);
      if (portEnd < 0) portEnd = body.indexOf("}", portStart);
      if (portEnd > portStart) {
        targetServerPort = body.substring(portStart, portEnd).toInt();
      }
    }
    int siStart = body.indexOf("\"sensor_interval_ms\":");
    if (siStart >= 0) {
      siStart += 22;
      int siEnd = body.indexOf(",", siStart);
      if (siEnd < 0) siEnd = body.indexOf("}", siStart);
      if (siEnd > siStart) {
        unsigned long newInterval = body.substring(siStart, siEnd).toInt();
        if (newInterval >= 1000 && newInterval != sensorIntervalMs) {
          sensorIntervalMs = newInterval;
          transmitIntervalMs = newInterval;
          Serial.print("  Config: interval → ");
          Serial.print(newInterval);
          Serial.println("ms");
        }
      }
    } else if (sensorIntervalMs != defaultSensorIntervalMs) {
      // No interval in config = test mode off, restore defaults
      sensorIntervalMs = defaultSensorIntervalMs;
      transmitIntervalMs = defaultSensorIntervalMs;
      Serial.println("  Config: interval → default");
    }
    Serial.print("  Config: target → ");
    Serial.print(targetServerIP);
    Serial.print(":");
    Serial.println(targetServerPort);
  } else {
    Serial.print("  Config query failed (HTTP ");
    Serial.print(httpCode);
    Serial.println(") — using defaults");
  }
  http.end();
}
