  while (WiFi.status() != WL_CONNECTED && wifi_attempts < 10) {
    delay(500);
    Serial.print(".");
    wifi_attempts++;
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("");
    Serial.print("  WiFi connected. IP: ");
    Serial.println(WiFi.localIP());
    Serial.println("  Copy that IP into the node config.json as \"ip_address\"");
