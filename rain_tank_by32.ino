// ═══════════════════════════════════════════════════════════════
//  sendToServer — priority-based channel fallback
//  Priority: wifi → serial
// ═══════════════════════════════════════════════════════════════
bool sendToServer(const char* endpoint, const char* payload) {
  // ── Try WiFi ──────────────────────────────────────────────
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient _http;
    String _url = "http://" + String(targetServerIP) + ":" + String(targetServerPort) + String(endpoint);
    _http.begin(_url);
    _http.setTimeout(3000);  // 3s — don't block long enough to trip WDT
    _http.addHeader("Content-Type", "application/json");
    _http.addHeader("X-API-Key", "farm-ope-5e355vx0");
    int _code = _http.POST(payload);
    _http.end();
    if (_code == 200 || _code == 201) {
      Serial.println("  -> Sent via WiFi");
      return true;
    } else {
      Serial.print("  -> WiFi POST failed, HTTP ");
      Serial.println(_code);
    }
  }
  // ── Fallback: Serial (USB bridge reads this) ──────────────
  return false;  // Caller handles Serial.print for sensor lines
}

// ═══════════════════════════════════════════════════════════════
//  MAIN LOOP
//
//  Timing strategy:
//    - Flow sensors: 1-second millis timer (needed for accurate rate calc)
//    - Float sensors: 1-second millis timer (no blocking delays)
//    - POST to server: transmitIntervalMs millis timer
//    - Deep sleep: reads/POSTs unconditionally (only one loop before reboot)
//    - Powered mode: 50ms yield keeps web server responsive
// ═══════════════════════════════════════════════════════════════
void loop() {
  esp_task_wdt_reset();
  // ── Re-check server config every CONFIG_CHECK_INTERVAL ─────
  if (millis() - lastConfigCheck > CONFIG_CHECK_INTERVAL) {
    lastConfigCheck = millis();
    fetchServerConfig();
  }
  // Handle incoming HTTP requests (ping from Farm OS)
  server.handleClient();

  // ── Flow sensors — 1-second millis timer ───────────────────
  // Interrupts count pulses continuously; we sample every 1s for rate calc.
  static unsigned long flowLastMillis = 0;
  bool flowReady = (powerMode == PM_LOW_POWER) || (millis() - flowLastMillis >= 1000);
  if (flowReady) {
    flowLastMillis = millis();

    // -- yf_s201_2 (flow sensor 1, GPIO 25) --
    detachInterrupt(digitalPinToInterrupt(yf_s201_2_PIN));
    unsigned long yf2_pulses = yf_s201_2_pulseCount;
    yf_s201_2_pulseCount = 0;
    yf_s201_2_lastPulses = yf2_pulses;
    yf_s201_2_flowRate = (yf2_pulses * 60.0) / yf_s201_2_cal_factor;
    yf_s201_2_totalVolume += yf_s201_2_flowRate / 60.0;
    Serial.print("yf_s201_2_pulse_count:"); Serial.println(yf2_pulses);
    Serial.print("yf_s201_2_flow_rate:");   Serial.println(yf_s201_2_flowRate);
    Serial.print("yf_s201_2_total_volume:"); Serial.println(yf_s201_2_totalVolume);
    attachInterrupt(digitalPinToInterrupt(yf_s201_2_PIN), yf_s201_2_pulseCounter, FALLING);

    // -- yf_s201 (flow sensor 2, GPIO 26) --
    detachInterrupt(digitalPinToInterrupt(yf_s201_PIN));
    unsigned long yf1_pulses = yf_s201_pulseCount;
    yf_s201_pulseCount = 0;
    yf_s201_lastPulses = yf1_pulses;
    yf_s201_flowRate = (yf1_pulses * 60.0) / yf_s201_cal_factor;
    yf_s201_totalVolume += yf_s201_flowRate / 60.0;
    Serial.print("yf_s201_pulse_count:"); Serial.println(yf1_pulses);
    Serial.print("yf_s201_flow_rate:");   Serial.println(yf_s201_flowRate);
    Serial.print("yf_s201_total_volume:"); Serial.println(yf_s201_totalVolume);
    attachInterrupt(digitalPinToInterrupt(yf_s201_PIN), yf_s201_pulseCounter, FALLING);

    Serial.flush();
  }

  // ── Float sensors — 1-second millis timer (no blocking delay) ──
  static unsigned long floatLastMillis = 0;
  bool floatReady = (powerMode == PM_LOW_POWER) || (millis() - floatLastMillis >= 1000);
  if (floatReady) {
    floatLastMillis = millis();

    float_sensor_level   = digitalRead(float_sensor_PIN);
    float_sensor_2_level = digitalRead(float_sensor_2_PIN);
    float_sensor_3_level = digitalRead(float_sensor_3_PIN);

    Serial.print("float_sensor_level:");   Serial.println(float_sensor_level);
    Serial.print("float_sensor_2_level:"); Serial.println(float_sensor_2_level);
    Serial.print("float_sensor_3_level:"); Serial.println(float_sensor_3_level);
    Serial.flush();
  }

  // ── POST sensor readings — transmitIntervalMs timer ────────
  // In deep sleep mode, always POST (only one loop before reboot).
  static unsigned long postLastMillis = 0;
  bool doPost = (powerMode == PM_LOW_POWER) || (millis() - postLastMillis >= transmitIntervalMs);
  if (doPost) {
    postLastMillis = millis();
    char _postBuf[256];

    // Flow sensor 1 readings
    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"yf_s201_2_pulse_count\",\"value\":%lu}",
      yf_s201_2_lastPulses);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"yf_s201_2_flow_rate\",\"value\":%.2f}",
      yf_s201_2_flowRate);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"yf_s201_2_total_volume\",\"value\":%.2f}",
      yf_s201_2_totalVolume);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    // Flow sensor 2 readings
    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"yf_s201_pulse_count\",\"value\":%lu}",
      yf_s201_lastPulses);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"yf_s201_flow_rate\",\"value\":%.2f}",
      yf_s201_flowRate);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"yf_s201_total_volume\",\"value\":%.2f}",
      yf_s201_totalVolume);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    // Float sensor readings
    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"float_sensor_level\",\"value\":%d}",
      float_sensor_level);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"float_sensor_2_level\",\"value\":%d}",
      float_sensor_2_level);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();

    snprintf(_postBuf, sizeof(_postBuf),
      "{\"node_name\":\"rain_tank_by32\",\"sensor\":\"float_sensor_3_level\",\"value\":%d}",
      float_sensor_3_level);
    sendToServer("/api/v1/sensor_reading", _postBuf);
    esp_task_wdt_reset();
  }

  // ── Check Serial for commands ─────────────────────────────
  if (Serial.available()) {
    String serialIn = Serial.readStringUntil('\n');
    serialIn.trim();
    handlePowerCommand(serialIn);
    if (serialIn == "REBOOT") {
      Serial.println("  Rebooting...");
      Serial.flush();
      delay(100);
      ESP.restart();
    }
  }
  // ── Sleep (power mode aware) ──────────────────────────────
  Serial.flush();
  if (powerMode == PM_LOW_POWER) {
    Serial.print("  Deep sleep for ");
    Serial.print(sensorIntervalMs / 1000);
    Serial.println("s...");
    Serial.flush();
    esp_deep_sleep(sensorIntervalMs * 1000ULL);
  } else if (powerMode == PM_SOLAR) {
    Serial.print("  Light sleep for ");
    Serial.print(sensorIntervalMs / 1000);
    Serial.println("s...");
    Serial.flush();
    esp_sleep_enable_timer_wakeup(sensorIntervalMs * 1000ULL);
    esp_light_sleep_start();
  } else {
    // Short yield — keeps web server responsive.
    // Actual read/transmit timing handled by millis timers above.
    delay(50);
  }
}
// ── POWER: powered_node ──────────────────────────────────────────
// Sleep mode determined by NVS-backed power preset.
// Compiled default: powered_node (none, 5s)
// Change at runtime via serial: POWER:low_power / POWER:solar / POWER:powered
