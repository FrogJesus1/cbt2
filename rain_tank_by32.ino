  // Register HTTP routes and start the web server
  server.on("/ping", HTTP_GET, handlePing);
  server.begin();
  Serial.println("  Web server started on port 80.");
  // Setup: yf_s201_2 (flow sensor 1 on GPIO 25)
  pinMode(yf_s201_2_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(yf_s201_2_PIN), yf_s201_2_pulseCounter, FALLING);
  // Setup: float_sensor (GPIO 13)
  pinMode(float_sensor_PIN, INPUT_PULLUP);
  // Setup: float_sensor_2 (GPIO 14)
  pinMode(float_sensor_2_PIN, INPUT_PULLUP);
  // Setup: yf_s201 (flow sensor 2 on GPIO 26)
  pinMode(yf_s201_PIN, INPUT_PULLUP);
  attachInterrupt(digitalPinToInterrupt(yf_s201_PIN), yf_s201_pulseCounter, FALLING);
  // Setup: float_sensor_3 (GPIO 33)
  pinMode(float_sensor_3_PIN, INPUT_PULLUP);
  // Watchdog: auto-reboot if loop hangs for 30 seconds
  esp_task_wdt_config_t wdt_config = {
    .timeout_ms = 30000,
    .idle_core_mask = 0,
    .trigger_panic = true
  };
  esp_task_wdt_reconfigure(&wdt_config);
  esp_task_wdt_add(NULL);
  // ── Query server config (dev/prod mode) ───────────────────
  delay(1000);  // Let network settle
  fetchServerConfig();
